# =========================================================
# FITCORE GYM TRAINER MANAGEMENT SYSTEM — ENVIRONMENT CONFIG
# =========================================================

# 1. Supabase Project URL & Anonymous Key (Client + Server Safe)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# 2. Supabase Service Role Key (SERVER ONLY — NEVER EXPOSE TO CLIENT!)
# Used for server-side auth.admin.createUser() when trainer provisions member accounts
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
